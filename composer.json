{
    "name": "contenir-extension/formbuilder",
    "description": "The form builder module for Contenir CMS: the Forms area, with forms, fields, notifications, webhooks and entries, over contenir/contenir-formbuilder.",
    "type": "contenir-extension",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "contenir-extension",
        "forms",
        "form-builder"
    ],
    "support": {
        "issues": "https://github.com/contenir-extension/formbuilder/issues",
        "source": "https://github.com/contenir-extension/formbuilder"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-formbuilder": "^2.0.0-RC3",
        "contenir/contenir-extension-api": "0.6.x-dev",
        "php-db/phpdb": "^0.6.0",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "nyholm/psr7": "^1.8.2",
        "peptolab/phpdb-migration": "^0.2",
        "php-db/phpdb-sqlite": "^0.3",
        "phpunit/phpunit": "^11.5.42"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/contenir/contenir-extension-api"
        }
    ],
    "autoload": {
        "psr-4": {
            "Contenir\\Extension\\Formbuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Extension\\Formbuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "boundary": "extension-boundary",
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint",
            "mago guard"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "extra": {
        "contenir": {
            "handle": "formbuilder",
            "extension": "Contenir\\Extension\\Formbuilder\\FormbuilderExtension"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

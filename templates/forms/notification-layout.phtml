<?php
/**
 * A notification's Layout: the page's title and the form's tabs, the Details and Layout pills, then
 * a card with the token picker and Save above the email's HTML, edited on the left in CodeMirror
 * while the right renders it live (NotificationLayout, which posts it to the preview with the
 * handler token from the hidden field at the end). The textarea stays in the form, hidden, so the
 * page saves with a plain post.
 *
 * @var array{
 *     title: string,
 *     form: \Contenir\FormBuilder\Definition\FormDefinition,
 *     notification: int,
 *     body: string,
 *     tags: list<array{label: string, items: list<array{tag: string, description: string}>}>,
 * } $values
 * @var \Contenir\Extension\Api\Module\TemplateHelpersInterface $view
 */
$form = $values['form'];
$keys = ['form' => (int) $form->id, 'notification' => $values['notification']];
?>
                <div class="pageheader pageheader--row">
                    <div class="pageheader__content">
                        <h1 class="pageheader__title"><?= $view->escape($values['title']) ?></h1>
                    </div>
                </div>
<?= $view->tabs() ?>
<?= $view->render('forms/notifications/pills', $keys + ['current' => 'notification-layout']) ?>

                <form class="card notification-layout" action="<?= $view->escape($view->url('notification-layout', $keys)) ?>" method="post" data-notification-layout data-preview-url="<?= $view->escape($view->url('notification-preview', $keys)) ?>">
                    <?= $view->token() ?>
                    <div class="card__header card__header--row">
                        <p class="card__description">Edit the email&rsquo;s HTML on the left; the right shows it as it will look, with recognised tokens highlighted.</p>
                        <div class="cluster cluster--sm">
                            <button type="button" class="btn btn--outline btn--sm" data-toggle="dropdown" data-menu-template="token-picker-layout" data-menu-tokens='{"target":"codemirror"}'><?= $view->icon('braces') ?><span>Insert token</span></button>
                            <button type="submit" class="btn btn--primary btn--sm"><?= $view->icon('check') ?><span>Save</span></button>
                        </div>
                    </div>
                    <div class="notification-layout__panes">
                        <div class="notification-layout__editor">
                            <textarea data-notification-layout-editor name="body_template" aria-label="Email HTML"><?= $view->escape($values['body']) ?></textarea>
                        </div>
                        <div class="notification-layout__preview">
                            <iframe data-notification-layout-preview title="Email preview"></iframe>
                        </div>
                    </div>
                </form>
<?= $view->render('forms/notifications/tag-picker', ['id' => 'layout', 'tags' => $values['tags']]) ?>
                <div data-formbuilder-token hidden><?= $view->token() ?></div>
